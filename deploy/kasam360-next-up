#!/bin/sh
set -eu

if [ "$#" -ne 0 ]; then
  echo "Bu wrapper argüman kabul etmez." >&2
  exit 64
fi

# Yalnız kasam360next projesine dokunur; eski uygulama ve Mailu etkilenmez.
project_dir=/opt/kasam360-next
cd "$project_dir/deploy"

run() {
  /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root \
  docker compose \
    --project-name kasam360next \
    --project-directory "$project_dir/deploy" \
    --file "$project_dir/deploy/compose.yaml" \
    --env-file "$project_dir/deploy/.env" "$@"
}

run config --quiet
run pull
exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root \
  docker compose \
    --project-name kasam360next \
    --project-directory "$project_dir/deploy" \
    --file "$project_dir/deploy/compose.yaml" \
    --env-file "$project_dir/deploy/.env" \
    up --detach --no-build
