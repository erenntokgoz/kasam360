# SHA etiketleri, GitHub Actions tarafından üretilen image etiketleridir.
KASAM360_SHA=6522d02e0d5d2483911a629a28bd039a1396944a
LABS360_SHA=82ff5fa3016206a48239fdcf8d9a0b2f100bb298

# İlk yalnız-loopback smoke değerleri. Gerçek alan adı ve TLS açılmadan güncellenmelidir.
SITE_URL=http://127.0.0.1:3100
ALLOWED_ORIGINS=http://127.0.0.1:3100
LABS_APP_ORIGIN=https://127.0.0.1:3610
# İlk Labs kurulumu içindir. Yönetici oluşturulduktan sonra bu iki değeri .env'den silin.
LABS_ADMIN_BOOTSTRAP_EMAIL=
LABS_ADMIN_BOOTSTRAP_PASSWORD=

# Gerçek müşteri verisi kullanmayın. İki ayrı staging URI'si, replica set veya sharded cluster olmalıdır.
MONGODB_ACCOUNT_URI=
MONGODB_ACCOUNT_DB=kasam360_account_staging
MONGODB_BUSINESS_URI=
MONGODB_BUSINESS_DB=kasam360_business_staging
AUTH_SECRET=

# Boş bırakılan isteğe bağlı entegrasyonlar kapalı kalır.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
LABS_SUPPORT_TOKEN=
LABS_CATALOG_TOKEN=
LABS_CUSTOMER_SECRET=
LICENSE_SIGNING_KEY=
