# Görüntü etiketi: develop veya CI'ın ürettiği tam commit SHA'sı.
IMAGE_TAG=develop
# Labs görüntüsünün etiketi (kasam360 görüntülerinden ayrı sürümlenir).
LABS_IMAGE_TAG=develop

# Genel adresler. Alan adı ve TLS açılana kadar loopback kalabilir.
SITE_URL=
ALLOWED_ORIGINS=
LABS_APP_ORIGIN=

# MongoDB bağlantısı compose içinde sabittir (mongo:27017, rs0); yalnız veritabanı adları ayarlanır.
MONGODB_ACCOUNT_DB=kasam360_account
MONGODB_BUSINESS_DB=kasam360_business

# Üretim: openssl rand -hex 32
AUTH_SECRET=
# API ile Labs arasında paylaşılan sır; Labs tarafında KASAM_CUSTOMER_SECRET olarak aynı değer kullanılır. Üretim: openssl rand -hex 32
LABS_CUSTOMER_SECRET=
# Labs SMTP hesap parolalarını şifreler; kaybolursa parolalar yeniden girilir. Üretim: openssl rand -hex 32
LABS_SECRET_KEY=
# API'nin Labs'a eriştiği jetonlar. Üretim: openssl rand -hex 32
LABS_SUPPORT_TOKEN=
LABS_CATALOG_TOKEN=
# Lisans imzalama anahtarı; yoksa boş bırakın.
LICENSE_SIGNING_KEY=

# İlk Labs yöneticisi. Hesap oluştuktan sonra iki satırı silip servisi yeniden başlatın.
LABS_ADMIN_BOOTSTRAP_EMAIL=
LABS_ADMIN_BOOTSTRAP_PASSWORD=

# İsteğe bağlı: boş bırakılan entegrasyonlar kapalı kalır.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API yedek SMTP (Mailu Labs E-posta sayfasından ayarlanıyorsa boş kalabilir).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Labs Mailu ve Gemini
MAILU_SMTP_HOST=
MAILU_IMAP_HOST=
MAILU_ACCOUNTS=
MAILU_MAILBOXES=
GEMINI_API_KEY=
