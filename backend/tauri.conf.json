{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "KASAM360",
  "version": "0.2.0",
  "identifier": "com.kasam360.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix desktop run dev",
    "beforeBuildCommand": "npm --prefix desktop run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../desktop/dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "app": {
    "windows": [
      {
        "title": "Kasam360",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src 'self' ipc: http://ipc.localhost https://kasam360.com.tr https://api.kasam360.com.tr http://localhost:3000"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/erenntokgoz/kasam360/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
