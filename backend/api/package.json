{
  "name": "kasam360-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:dev": "tsx src/devDb.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "^1.7.15",
    "hono": "4.13.14",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
