PORT=4000

# Site adresi; doğrulama bağlantıları ve Google dönüşü bu adresle üretilir.
SITE_URL=http://localhost:3000

# Yalnız bu kaynaklardan gelen istekler kabul edilir.
ALLOWED_ORIGINS=http://localhost:3000,https://kasam360.com.tr,https://www.kasam360.com.tr,http://tauri.localhost,http://localhost:1420

# Hesap kümesi: üyelik, oturum, lisans anahtarı. İşletme kümesi: kasa eşitleme kaydı.
# SRV adresi (mongodb+srv) bazı ağlarda Node'da çözülmez; o durumda standart adres (mongodb://) kullanın.
MONGODB_ACCOUNT_URI=
MONGODB_ACCOUNT_DB=kasam360_account
MONGODB_BUSINESS_URI=
MONGODB_BUSINESS_DB=kasam360_business

# En az 32 karakter rastgele değer üretin.
AUTH_SECRET=

# Boşsa Google ile giriş kapalı kalır.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Aşağıdaki adresler örnektir; gerçek teslim için API hesabınıza ait çalışan sağlayıcı değerleri gerekir.
# Yerel başlatıcı zorunlu alanlardan biri yoksa postayı gelen kutusuna göndermez, state-dir/mail içine yakalar.
SMTP_HOST=mail.kasam360.com.tr
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=noreply@kasam360.com.tr
SMTP_PASSWORD=
SMTP_FROM=noreply@kasam360.com.tr
LABS_SUPPORT_ORIGIN=http://127.0.0.1:3600
LABS_SUPPORT_TOKEN=
LABS_CUSTOMER_SECRET=
# Yalnız API sunucusu kullanır; Labs'taki ürün entegrasyon anahtarı tarayıcıya gitmez.
LABS_CATALOG_ORIGIN=http://127.0.0.1:3600
LABS_CATALOG_TOKEN=
# Ed25519 PKCS#8 DER, base64. Açık anahtar masaüstü uygulamasına gömülür.
LICENSE_SIGNING_KEY=
